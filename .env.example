# MedGuard AI — Environment Variables Example
# Copy this file to .env.local and fill in your actual credentials.
# .env and .env.local are ignored by Git to prevent leaking sensitive API keys.

# Google Gemini Vision / Clinical Reasoning API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Cloud Firestore API Key (Optional client key)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

